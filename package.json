{
  "name": "touchline",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prototype": "python3 -m http.server 8000 --directory prototype"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
