{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@touchline/app", "exec", "expo", "start", "--web", "--port", "8081"],
      "env": { "CI": "1" },
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@touchline/backend", "dev"],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@touchline/admin", "dev"],
      "port": 3001
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8000", "--directory", "prototype"],
      "port": 8000
    }
  ]
}
